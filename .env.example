# KIPRIS Plus OpenAPI 인증키 (필수)
# 발급: https://plus.kipris.or.kr → 회원가입 후 "특허·실용 공개등록공보" 등 활용신청
# data.go.kr 발급 키도 동일하게 사용 가능
KIPRIS_API_KEY=your-kipris-access-key

# API 호출 프로토콜 (기본: https). 키가 쿼리스트링에 실리므로 https 권장.
# 망 제약 등으로 평문이 필요할 때만 http 로 명시.
# KIPRIS_API_PROTOCOL=https

# --- HTTP 모드(클라우드 배포)에서만 사용 ---
# CORS 허용 도메인 (기본 * — 프로덕션에서는 도메인 명시 권장)
# CORS_ORIGIN=https://your-frontend.example.com
# IP당 분당 요청 한도 (기본 60)
# RATE_LIMIT_RPM=60
# POST body 한도 (기본 100kb)
# MCP_BODY_LIMIT=100kb
# 단일 POST(JSON-RPC 배치)에 허용하는 tools/call 최대 개수 (기본 20)
# MCP_MAX_BATCH_CALLS=20

# 자체 키 없는 요청이 서버 KIPRIS_API_KEY 로 폴백할 때의 보호 장치.
# 분당 상한만으로는 월 한도를 못 지킨다 — 총량 방어는 일일 캡이 담당한다.
# 전역 분당 상한, 토큰버킷 (기본 10, 0이면 폴백 차단 = BYOK 강제)
# FALLBACK_RATE_LIMIT_RPM=10
# 토큰버킷 용량 (기본 = FALLBACK_RATE_LIMIT_RPM)
# FALLBACK_RATE_LIMIT_BURST=10
# 롤링 24시간 총량 캡 (기본 30 ≈ KIPRIS 무료 1,000회/월 ÷ 31)
# FALLBACK_DAILY_CAP=30
